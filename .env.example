# ==============================================================================
# ARGUS - VARIÁVEIS DE AMBIENTE ESSENCIAIS (.env.example)
# ==============================================================================

# 1. URL da Aplicação
NEXT_PUBLIC_APP_URL=https://argus.app.br

# 2. Supabase (Banco de Dados PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# 3. Google Gemini (Motor de Inteligência Artificial)
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-2.0-flash

# 4. Gateway de Pagamento Asaas (Pix Instantâneo) & Stripe
PAYMENT_GATEWAY_PROVIDER=asaas
ASAAS_API_KEY=$aact_sua_chave_asaas_aqui
ASAAS_ENVIRONMENT=production
ASAAS_WEBHOOK_SECRET=token-secreto-configurado-no-painel-asaas
STRIPE_WEBHOOK_SECRET=whsec_sua_chave_secreta_stripe

# 5. E-mail Transacional de Boas-Vindas (Resend)
RESEND_API_KEY=re_sua_chave_resend_aqui

# 6. Chave Secreta Administrativa (Rotas /api/admin e ingestão de provas)
ADMIN_API_KEY=gere-um-segredo-forte-aqui

# 7. Telemetria & Tráfego Pago (Meta Ads & Google Analytics)
NEXT_PUBLIC_META_PIXEL_ID=seu_pixel_id_aqui
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
